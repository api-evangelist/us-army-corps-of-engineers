          "name": "Get Timeseries Data",
          "request": {
            "name": "Get Timeseries Data",
            "description": {
              "content": "Retrieves timeseries data from the CWMS database. Results can be filtered by office, location, and time range. Dates may be in ISO 8601 format or milliseconds since the Unix epoch.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Timeseries identifier (e.g., TULA.Flow.Inst.1Hour.0.CBT-RAW)"
                },
                {
                  "disabled": false,
                  "key": "office",
                  "value": "<string>",
                  "description": "The office that owns the timeseries"
                },
                {
                  "disabled": false,
                  "key": "unit",
                  "value": "<string>",
                  "description": "The units for the time series values"
                },
                {
                  "disabled": false,
                  "key": "datum",
                  "value": "<string>",
                  "description": "The vertical datum for elevation timeseries"
                },
                {
                  "disabled": false,
                  "key": "begin",
                  "value": "<string>",
                  "description": "Start time in ISO 8601 format or milliseconds"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End time in ISO 8601 format or milliseconds"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "Timezone for time formatting"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response format"
                },
                {
                  "disabled": false,
                  "key": "page-size",
                  "value": "500",
                  "description": "Number of records to return per page"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<string>",
                  "description": "Page cursor for pagination"
                }
              ],
              "variable": []
            },
            "header": [
